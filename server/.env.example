# 复制成 .env 后按需修改：cp .env.example .env
# install.sh 会自动生成 SESSION_SECRET 和 ADMIN_PASSWORD

# 你的域名（已解析到本服务器）
DOMAIN=fineuedesign.com

# 经验库网页地址（MCP 返回的链接用）。默认就是 https://<DOMAIN>/ ，网页由本服务器直接提供；一般不用填
SITE_URL=

# 除本域名外，还允许发送埋点的网页来源（GitHub Pages 备用地址），逗号分隔
ALLOWED_ORIGINS=https://lcy1021.github.io

# 会话签名密钥，随机 32 位以上，不要外泄
SESSION_SECRET=

# 后台登录方式一：GitHub OAuth（推荐）
# 在 GitHub → Settings → Developer settings → OAuth Apps 新建：
#   Homepage URL:  https://fineuedesign.com
#   Callback URL:  https://fineuedesign.com/admin/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGINS=lcy1021

# 后台登录方式二：独立密码（GitHub 没配好之前先用这个）
ADMIN_PASSWORD=

# MCP 申请只接受这些邮箱后缀（逗号分隔，如 example.com）；留空 = 不开放申请
APPLY_EMAIL_DOMAINS=

# MCP 是否必须带 token（1 = 必须，0 = 任何人可用）
MCP_REQUIRE_TOKEN=1

# 数据库备份保留天数
BACKUP_KEEP_DAYS=14
